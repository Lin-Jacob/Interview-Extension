# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored: never commit it.

# From https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Your free static domain from https://dashboard.ngrok.com/domains
# (just the host name, like something.ngrok-free.app)
NGROK_DOMAIN=

# Optional: the port the dashboard uses on this computer.
PORT=8787
