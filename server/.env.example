# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored: never commit it.

# From https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Your free static domain from https://dashboard.ngrok.com/domains
# (just the host name, like something.ngrok-free.app)
NGROK_DOMAIN=

# Logins for the dashboard: first name, a colon, then the password. Separate
# people with commas (passwords can't contain commas). When this is set,
# it's the whole list: remove a name to take away that login. Changes apply the
# next time the dashboard starts. Leave it empty to manage logins with
# `npm run add-user` instead. Example:
#   DASHBOARD_USERS=Jacob:pick-a-password,Sam:another-password
DASHBOARD_USERS=

# Optional: the port the dashboard uses on this computer.
PORT=8787
